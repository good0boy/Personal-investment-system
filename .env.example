# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=dev                 # dev | prod
DEBUG=true
HOST=127.0.0.1              # 本地用 127.0.0.1；容器内用 0.0.0.0
PORT=8000

# ---------- 数据根目录 ----------
# 留空 = 项目根下的 data/
# Docker 部署时挂载卷后指向 /app/data
DATA_ROOT=

# ---------- 服务模式：由后端直接托管前端 ----------
# 1 = 后端同时提供 frontend/dist 与 API（一个进程、一个端口跑整站）。
#     start-service.bat 会自动置 1，平时不用管这个开关。
# 0 = 默认。开发模式走 Vite dev server；容器部署由 nginx 托管静态文件。
SERVE_FRONTEND=0

# ---------- 企业微信 · 方案 A 群机器人 Webhook（推荐）----------
# 获取路径：企业微信 PC 端 → 建一个只有自己的群 → 右上角 … → 添加群机器人
#           → 新创建一个机器人 → 复制 Webhook 地址
# 形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx
WECOM_CHANNEL=webhook       # webhook | app
WECOM_WEBHOOK_URL=

# ---------- 企业微信 · 方案 B 自建应用（仅需要交互能力时启用）----------
# 获取路径见 技术架构.md 6.5 节
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_TOUSER=               # 通讯录 → 你自己的档案 → 账号

# ---------- 数据源 ----------
AKSHARE_VERSION_PIN=1.18.94

# ---------- 数据源：同花顺 fuyao REST（涨跌停池 / 板块成分 / 特色数据）----------
# 申请与查看：https://fuyao.aicubes.cn/admin/ （API Key 管理）
# ⚠️ 绝不提交到版本库，也绝不出现在任何 API 响应里 —— 只走 X-api-key 请求头
FUYAO_API_KEY=
